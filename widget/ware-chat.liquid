    .ware-chat-menu button:hover:not(:disabled) {
      background: var(--faq-bg);
    }
    .ware-chat-menu button:disabled {
      opacity: 0.45;
      cursor: default;
    }


    /*
   Full screen / smaller window only means something on a computer: phones
   already get the whole screen. (Selector as specific as the one above,
   or that one's display: flex would win.) */
    @media (max-width: 700px),
    (hover: none) {
      .ware-chat-menu button.ware-chat-menu-expand {
        display: none;
      }
    }


    /*
   Messages: the concierge writes in serif straight on the cream; the
   shopper's messages are peach pills. No timestamps.
*/
    .ware-chat-root .faq-chat-messages {
      padding: 20px 16px;
      gap: 20px;
    }
    .ware-chat-root .faq-chat-bubble.faq-chat-ai:not(.faq-chat-team):not(.faq-chat-contact):not(.faq-chat-contact-prompt) {
      max-width: 100%;
      padding: 0;
      border: none;
      background: none;
      font-family: var(--ware-serif);
      font-size: var(--ware-reply-size);
      line-height: 1.5;
      color: var(--ware-ink);
    }
    .ware-chat-root .faq-chat-bubble.faq-chat-typing {
      padding: 6px 0;
    }
    .ware-chat-root .faq-chat-user {
      padding: 7px 13px;
      border-radius: 16px;
      background: var(--ware-peach);
      color: var(--ware-brown);
      font-size: var(--ware-message-size);
      font-weight: 500;
    }
    .ware-chat-root .faq-chat-time,
    .ware-chat-root .faq-chat-bubble-actions,
    .ware-chat-root .faq-chat-meta-user:not(:has(.faq-chat-sent-team)) {
      display: none;
    }

    /*
   Everything inside a reply other than the words themselves goes back to
   the sans at a normal size.
*/
    .ware-chat-root .faq-chat-products,
    .ware-chat-root .faq-chat-similar-offer,
    .ware-chat-root .faq-chat-more-btn,
    .ware-chat-root .faq-chat-whatsapp-btn,
    .ware-chat-root .faq-chat-gift-image,
    .ware-chat-root .faq-chat-restock-done {
      font-family: var(--ware-sans);
      font-size: 13.5px;
      line-height: 1.45;
    }

    /* Suggestion chips and small pill buttons */
    .ware-chat-welcome {
      gap: 16px;
    }
    .ware-chat-suggestion,
    .ware-chat-root .faq-chat-similar-btn {
      padding: 7px 13px;
      border: 1px solid #e9c4aa;
      border-radius: 999px;
      background: transparent;
      color: var(--ware-brown);
      font-size: 13px;
      font-weight: 500;
    }
    .ware-chat-suggestion:hover,
    .ware-chat-root .faq-chat-similar-btn:hover {
      background: var(--ware-peach);
      border-color: var(--faq-accent);
      color: var(--ware-brown);
    }

    /* A product's options: the details, then "Show me more like this" on its
       own line. */
    .ware-chat-options {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 10px;
    }

    /* Product cards: a swipeable row */
    .ware-chat-root .faq-chat-products {
      gap: 10px;
      margin: 14px -16px 0;
      padding: 0 16px 6px;
      scroll-padding: 0 16px;
      scrollbar-width: none;
    }
    .ware-chat-root .faq-chat-products::-webkit-scrollbar {
      display: none;
    }
    /* ‹ › buttons for mouse users; phones just swipe. */
    .ware-row {
      position: relative;
    }
    .ware-row-arrow {
      position: absolute;
      top: 82px;
      /* level with the middle of the card photos */
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border: 1px solid var(--ware-line);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.95);
      color: var(--ware-ink);
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(60, 35, 20, 0.16);
      transition: background-color 0.15s ease
      , color 0.15s ease;
    }
    .ware-row-arrow:hover {
