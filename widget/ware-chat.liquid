    /*
   Store-only layout for the chat, on top of the shared Faq.css. Everything
   lives in the widget's shadow root, so none of this reaches the theme.
*/


    /*
   The shared styles hang off .faq-page (colours, box-sizing); undo its
   page layout so it's just a wrapper here. Colours, fonts and sizes are
   variables set in theme.css (the "easy edits" at the top of the
   snippet). Fonts are set rather than inherited from the store's theme: a
   serif for the concierge's voice and a clean sans for everything else.
*/.ware-chat-root.faq-page {
      font-family: var(--ware-sans);
      width: auto;
      min-width: 0;
      max-width: none;
      margin: 0;
      padding: 0;
      background: none;
      font-size: 14px;
      line-height: 1.4;
      letter-spacing: normal;
      text-transform: none;
      text-align: left;
    }
    .ware-chat-root button,
    .ware-chat-root input,
    .ware-chat-root textarea {
      font-family: inherit;
      letter-spacing: normal;
      text-transform: none;
    }

    /* ---------- Floating button ---------- */
    .ware-chat-launcher {
      position: fixed;
      right: 27px;
      bottom: var(--ware-chat-bottom);
      z-index: 2147483001;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--faq-accent);
      color: #fff;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(20, 24, 21, 0.28);
      transition: transform 0.18s ease
      , background-color 0.15s ease;
    }
    .ware-chat-launcher:hover {
      background: var(--ware-accent-hover);
      transform: scale(1.05);
    }
    /* The shared styles hard-code the site's dark green for these hovers. */
    .ware-chat-root .faq-btn-primary:hover,
    .ware-chat-root .faq-chat-send-btn:hover {
      background: var(--ware-accent-hover);
      border-color: var(--ware-accent-hover);
    }

    /* ---------- "Ask me anything" pill (chat closed) ---------- */
    .ware-chat-pill {
      position: fixed;
      right: 20px;
      bottom: var(--ware-chat-bottom);
      z-index: 2147483001;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 11px 20px 11px 16px;
      color: var(--ware-pill-text);
      font-size: var(--ware-pill-size);
      font-weight: 500;
      line-height: 1;

      /*
   Frosted glass: translucent white that blurs the page behind it, with
   a bright hairline edge. Solid white where blur isn't supported.
*/
      border: 1px solid rgba(255, 255, 255, 0.7);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.62);
      -webkit-backdrop-filter: blur(16px) saturate(170%);
      backdrop-filter: blur(16px) saturate(170%);
      text-align: left;
      white-space: nowrap;
      cursor: pointer;
      box-shadow: 0 8px 28px rgba(60, 35, 20, 0.14)
      , 0 1px 3px rgba(60, 35, 20, 0.08)
      , inset 0 1px 0 rgba(255, 255, 255, 0.8);
      /* "backwards", not "both": a held end state would override the hover lift. */
      animation: ware-chat-pill-in 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.2) backwards;
      transition: transform 0.2s ease
      , box-shadow 0.2s ease
      , background-color 0.2s ease;
    }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .ware-chat-pill {
        background: #fff;
        border-color: var(--faq-border);
      }
    }
    .ware-chat-pill:hover {
      transform: translateY(-2px);
      background: rgba(253, 245, 238, 0.8);
      box-shadow: 0 12px 32px rgba(60, 35, 20, 0.18)
      , 0 2px 4px rgba(60, 35, 20, 0.08)
      , inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }
    .ware-chat-pill:focus-visible {
      outline: 2px solid var(--faq-accent);
      outline-offset: 3px;
    }
    /* Sparkle in the main colour that gently twinkles (fades, shrinks and
       tilts a little, then back). */
    .ware-chat-pill-icon {
      display: inline-flex;
      flex-shrink: 0;
      color: var(--faq-accent);
      animation: ware-chat-twinkle 2.2s ease-in-out infinite;
    }
    @keyframes ware-chat-twinkle {
      0%,
      100% {
        opacity: 1;
        transform: scale(1) rotate(0deg);
      }
      50% {
        opacity: 0.35;
        transform: scale(0.8) rotate(-12deg);
      }
    }
    @keyframes ware-chat-pill-in {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.96);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .ware-chat-pill,
      .ware-chat-pill-icon {
        animation: none;
      }
    }


    /*
   ---------- The chat window ----------
   A floating panel above the button, instead of the site's full-height
   side drawer under a navbar.
*/
    .ware-chat-root .faq-chat-popup {
      top: auto;
      right: 20px;
      bottom: calc(var(--ware-chat-bottom) + 60px);
      z-index: 2147483000;
      width: var(--askai-w);
      height: min(720px, calc(100vh - var(--ware-chat-bottom) - 90px));
      border: 1px solid var(--faq-border);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 12px 40px rgba(20, 24, 21, 0.22);
      opacity: 0;
      pointer-events: none;
      transform: translateY(16px) scale(0.98);
      transform-origin: bottom right;
      transition: opacity 0.2s ease
      , transform 0.2s ease
      , width 0.28s ease
      , height 0.28s ease;
    }
    .ware-chat-root .faq-chat-popup-open {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
    .ware-chat-root .faq-chat-popup-expanded {
      width: min(1100px, calc(100vw - 96px));
      height: calc(100vh - var(--ware-chat-bottom) - 90px);
    }
    .ware-chat-root .faq-chat-backdrop {
      top: 0;
      z-index: 2147482999;
    }

    /* ---------- Store-only bits of the chat ---------- */
    .ware-chat-welcome {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .ware-chat-suggestions {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .ware-chat-suggestion {
      padding: 7px 12px;
      border-radius: 999px;
      border: 1px solid var(--faq-border-strong);
      background: var(--faq-panel);
      color: var(--faq-text);
      font-size: 12.5px;
      cursor: pointer;
      transition: background-color 0.15s ease
      , border-color 0.15s ease;
    }
    .ware-chat-suggestion:hover {
      background: var(--faq-accent-soft);
      border-color: var(--faq-accent);
    }
    .faq-chat-bubble .faq-chat-product-btn.ware-chat-added {
      background: var(--faq-accent-soft);
      border-color: var(--faq-border-strong);
      color: var(--ware-accent-hover);
    }

    /* ---------- Concierge look (the chat window) ---------- */
    .ware-chat-root .faq-chat-popup {
      background: var(--ware-cream);
      border-color: var(--ware-line);
    }

    /* Header: minimise, centred name, menu */
    .ware-chat-root .ware-chat-header {
      display: grid;
      grid-template-columns: 36px 1fr 36px;
      align-items: center;
      gap: 8px;
      padding: 12px;
      background: var(--ware-cream);
      border-bottom: 1px solid var(--ware-line);
    }
    .ware-chat-heading {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-align: center;
      min-width: 0;
    }
    .ware-chat-name {
      font-family: var(--ware-serif);
      font-size: var(--ware-title-size);
      font-weight: 500;
      line-height: 1.15;
      color: var(--ware-ink);
    }
    .ware-chat-root .ware-chat-header .faq-icon-btn {
      width: 36px;
      height: 36px;
      border: none;
      border-radius: 50%;
      background: transparent;
      color: var(--ware-ink);
    }
    .ware-chat-root .ware-chat-header .faq-icon-btn:hover {
      background: rgba(191, 94, 53, 0.08);
    }
    .ware-chat-menu-wrap {
      position: relative;
    }
    .ware-chat-menu-backdrop {
      position: fixed;
      inset: 0;
      z-index: 4;
    }
    .ware-chat-menu {
      position: absolute;
      top: 42px;
      right: 0;
      z-index: 5;
      min-width: 190px;
      padding: 6px;
      background: #fff;
      border: 1px solid var(--ware-line);
      border-radius: 12px;
      box-shadow: 0 12px 32px rgba(60, 35, 20, 0.14);
    }
    .ware-chat-menu button {
      display: flex;
      align-items: center;
      gap: 9px;
      width: 100%;
      padding: 9px 11px;
      border: none;
      border-radius: 8px;
      background: none;
      color: var(--ware-ink);
      font-size: 13.5px;
      text-align: left;
      cursor: pointer;
