# Local-only: serve chat-admin on its own port so it can run next to
# ask-faq (8000). Not a secret; the real keys live in ../.env.local.
DENO_SERVE_ADDRESS=tcp:127.0.0.1:8002
# The Bot section's "Try it" asks the local ask-faq.
ASK_FAQ_URL=http://127.0.0.1:8000
# "Sign in with Google": the same public client ID as src/lib/googleConfig.js.
GOOGLE_CLIENT_ID=378606428414-8ua697j7ue8grq58ncvfiffsa5eb5vo1.apps.googleusercontent.com
